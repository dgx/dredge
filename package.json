{
  "name": "dredge",
  "version": "0.5.6",
  "description": "Magic: The Gathering card browser",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icon": "node scripts/generate-icon.cjs",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win --x64",
    "electron:build:mac": "vite build && electron-builder --mac --arm64",
    "electron:build:all": "vite build && electron-builder --win --x64 --mac --arm64",
    "electron:preview": "vite build && cross-env NODE_ENV=production electron .",
    "release": "node scripts/release.cjs minor",
    "release:patch": "node scripts/release.cjs patch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgx/dredge.git"
  },
  "build": {
    "appId": "com.dgx.dredge",
    "productName": "Dredge Deckbuilder",
    "artifactName": "Dredge-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "dgx",
      "repo": "dredge"
    },
    "afterSign": "scripts/notarize.cjs",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "arm64"
      },
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "notarize": false
    }
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "mana-font": "^1.18.0",
    "pinia": "^2.2.0",
    "stream-json": "^2.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "vuetify": "^4.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.8",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.9.0",
    "vite": "^6.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.5",
    "wait-on": "^8.0.0"
  }
}
